{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/docs/sdk", "destination": "/" },
    { "source": "/docs/sdk/", "destination": "/" },
    { "source": "/docs/components", "destination": "/" },
    { "source": "/docs/components/", "destination": "/" }
  ]
}
